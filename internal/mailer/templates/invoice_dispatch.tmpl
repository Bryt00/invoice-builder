{{define "subject"}}{{ .CompanyName }} has sent you Invoice {{ .InvoiceNumber }}{{end}}

{{define "body"}}
Hello {{ .ClientName }},

You have received a new invoice from {{ .CompanyName }}.
Invoice #: {{ .InvoiceNumber }}
Total Amount Due: {{ .TotalAmount }}
Due Date: {{ .DueDate }}

A PDF copy of your invoice is attached to this email. 

You can also view your invoice online here:
{{ .InvoiceURL }}

Thank you for your business!
{{ .CompanyName }}
{{end}}

{{define "htmlBody"}}
<!doctype html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>Invoice {{ .InvoiceNumber }}</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f6f6f6; margin: 0; padding: 0; }
        .container { background-color: #ffffff; max-width: 600px; margin: 40px auto; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        h1 { font-size: 24px; color: #333333; margin-bottom: 20px; }
        p { font-size: 16px; line-height: 1.5; color: #555555; }
        .details { background-color: #f9f9f9; padding: 20px; border-radius: 6px; margin: 20px 0; border: 1px solid #eeeeee; }
        .details-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
        .details-row:last-child { margin-bottom: 0; }
        .label { font-weight: bold; color: #333333; }
        .value { color: #555555; }
        .btn { display: inline-block; padding: 12px 24px; background-color: #4B7355; color: #ffffff !important; text-decoration: none; border-radius: 4px; font-weight: bold; margin-top: 10px; }
        .footer { margin-top: 30px; font-size: 14px; color: #999999; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Hello {{ .ClientName }},</h1>
        <p>You have received a new invoice from <strong>{{ .CompanyName }}</strong>.</p>
        
        <div class="details">
            <div class="details-row">
                <span class="label">Invoice #:</span>
                <span class="value">{{ .InvoiceNumber }}</span>
            </div>
            <div class="details-row">
                <span class="label">Total Amount Due:</span>
                <span class="value" style="font-size: 18px; font-weight: bold; color: #4B7355;">{{ .TotalAmount }}</span>
            </div>
            <div class="details-row">
                <span class="label">Due Date:</span>
                <span class="value">{{ .DueDate }}</span>
            </div>
        </div>
        
        <p>A PDF copy of your invoice is attached to this email.</p>
        
        <div style="text-align: center; margin: 30px 0;">
            <a href="{{ .InvoiceURL }}" class="btn">View Invoice Online</a>
        </div>
        
        <p>Thank you for your business!</p>
        <p><strong>{{ .CompanyName }}</strong></p>
        
        <div class="footer">
            Powered by Teks-Invoice
        </div>
    </div>
</body>
</html>
{{end}}
