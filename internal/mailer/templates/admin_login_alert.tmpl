{{define "subject"}}Security Alert: Admin Login Detected{{end}}

{{define "body"}}
Hi {{.Name}},

A login to your admin account was just detected on Teks-Invoice.

Details:
- Email: {{.Email}}
- IP Address: {{.IP}}
- User Agent: {{.UserAgent}}
- Time: {{.Time}}

If this was you, you can safely ignore this email.
If you did not authorize this login, please secure your account immediately.

Best regards,
The Teks-Invoice Security Team
{{end}}

{{define "htmlBody"}}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
</head>
<body style="background-color: #faf6f0; font-family: 'Nunito Sans', Arial, sans-serif; margin: 0; padding: 20px; color: #2e3230;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; border: 1px solid #e4e0d8; overflow: hidden;">
        <tr>
            <td style="padding: 32px 32px 16px 32px; text-align: center; border-bottom: 1px solid #f0ece4;">
                <div style="display: inline-block; width: 48px; height: 48px; background-color: #d9534f; border-radius: 12px; line-height: 48px; color: #ffffff; font-size: 24px; font-weight: bold; margin-bottom: 12px;">
                    !
                </div>
                <h1 style="font-family: 'Literata', Georgia, serif; font-size: 24px; color: #2e3230; margin: 0;">Admin Login Alert</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 32px;">
                <p style="font-size: 16px; line-height: 24px; color: #2e3230; margin-top: 0;">Hi <strong>{{.Name}}</strong>,</p>
                <p style="font-size: 16px; line-height: 24px; color: #4a4e4a;">A login to your admin account was just detected on Teks-Invoice.</p>
                
                <table style="width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 14px; color: #4a4e4a;">
                    <tr>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4; font-weight: bold; width: 120px;">Email</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4;">{{.Email}}</td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4; font-weight: bold;">IP Address</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4;">{{.IP}}</td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4; font-weight: bold;">User Agent</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4;">{{.UserAgent}}</td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4; font-weight: bold;">Time</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #f0ece4;">{{.Time}}</td>
                    </tr>
                </table>

                <p style="font-size: 14px; line-height: 20px; color: #74796e;">If this was you, no further action is required.</p>
                <p style="font-size: 14px; line-height: 20px; color: #d9534f; font-weight: bold;">If you did not authorize this login, please secure your account and contact support immediately.</p>

                <hr style="border: none; border-top: 1px solid #f0ece4; margin: 24px 0;" />
                <p style="font-size: 12px; color: #74796e; margin-bottom: 0;">This is an automated security alert from Teks-Invoice.</p>
            </td>
        </tr>
    </table>
</body>
</html>
{{end}}
