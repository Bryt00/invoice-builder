{
  "name": "invoice-builder",
  "version": "1.0.0",
  "description": "Invoice Builder Tailwind Build Pipeline",
  "scripts": {
    "build:css": "npx tailwindcss -i ./ui/asset/css/input.css -o ./ui/asset/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./ui/asset/css/input.css -o ./ui/asset/css/styles.css --watch"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.11"
  }
}
